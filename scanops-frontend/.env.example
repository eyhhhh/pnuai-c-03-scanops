# 로컬 개발: 로컬 백엔드
VITE_API_BASE_URL=http://localhost:8080
# 배포(Vercel)에서는 프로덕션 백엔드로 설정: https://scanops-backend.kr

# 요금제/결제 기능 노출 여부 (기본 true). 요금제 없는 버전을 다른 도메인으로
# 배포하려면, 같은 레포를 연결한 별도 Vercel 프로젝트에서 이 값만 false로 설정.
# VITE_ENABLE_PRICING=false

# 오류 신고 위젯 → Google Apps Script 웹 앱 배포 URL.
# scripts/google-apps-script/Code.gs 배포 가이드 참고.
VITE_FEEDBACK_WEBAPP_URL=

# 베타테스터 사용경험 설문(마이페이지 → 설문 참여하기) → Google Apps Script 웹 앱 배포 URL.
# scripts/google-apps-script/SurveyCode.gs 배포 가이드 참고.
VITE_SURVEY_WEBAPP_URL=
